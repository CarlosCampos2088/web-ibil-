{#- Icono de WhatsApp (SVG en línea). Uso: {{ m.iconoWhatsapp() }} -#}
{% macro iconoWhatsapp() -%}
<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2m0 1.67a8.24 8.24 0 0 1 8.24 8.24 8.24 8.24 0 0 1-8.24 8.24c-1.5 0-2.95-.4-4.21-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38 8.24 8.24 0 0 1 8.26-8.24m-3.4 4.44c-.19 0-.5.07-.76.36-.26.28-1 .97-1 2.37 0 1.4 1.02 2.76 1.16 2.95.15.19 2 3.17 4.93 4.32 2.44.96 2.94.77 3.47.72.53-.05 1.7-.69 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.33-.29-.14-1.7-.84-1.97-.93-.26-.1-.46-.14-.65.14-.19.29-.74.93-.91 1.12-.17.19-.33.22-.62.07-.29-.14-1.22-.45-2.32-1.43-.86-.76-1.44-1.7-1.6-1.99-.17-.29-.02-.44.12-.59.13-.13.29-.33.43-.5.15-.17.19-.29.29-.48.1-.19.05-.36-.02-.5-.08-.15-.65-1.57-.9-2.14-.23-.56-.47-.49-.65-.5h-.56z"/></svg>
{%- endmacro %}

{#- Botón «Compartir por WhatsApp». Uso: {{ m.whatsapp(texto) }} -#}
{% macro whatsapp(texto, clase = "boton boton--secundario") -%}
<a class="{{ clase }} boton--icono" href="https://wa.me/?text={{ texto | urlencode }}" rel="noopener">{{ iconoWhatsapp() }}<span>Compartir por WhatsApp</span></a>
{%- endmacro %}

{#- Iconos de redes (monocromo, color de marca). Uso: {{ m.iconoRed("youtube") }} -#}
{% macro iconoRed(red) -%}
{%- if red == "youtube" -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
{%- elif red == "instagram" -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
{%- elif red == "facebook" -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/></svg>
{%- elif red == "tiktok" -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 2h-3v13.3a2.8 2.8 0 1 1-2.8-2.8c.3 0 .6 0 .8.1V9.5a5.9 5.9 0 1 0 5 5.8V8.6a7 7 0 0 0 4.2 1.4V7a4.2 4.2 0 0 1-4.2-4.2V2z"/></svg>
{%- endif -%}
{%- endmacro %}

{#- Lista de redes con icono. Uso: {{ m.redes(iglesia) }} -#}
{% macro redes(iglesia, clase = "redes") -%}
<ul class="{{ clase }}" role="list">
  <li><a href="{{ iglesia.redes.youtube }}" rel="noopener">{{ iconoRed("youtube") }}<span>YouTube</span></a></li>
  <li><a href="{{ iglesia.redes.instagram }}" rel="noopener">{{ iconoRed("instagram") }}<span>Instagram</span></a></li>
  <li><a href="{{ iglesia.redes.facebook }}" rel="noopener">{{ iconoRed("facebook") }}<span>Facebook</span></a></li>
  <li class="redes__pronto">{{ iconoRed("tiktok") }}<span>TikTok, próximamente</span></li>
</ul>
{%- endmacro %}
