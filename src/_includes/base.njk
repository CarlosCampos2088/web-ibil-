{% import "macros.njk" as m %}<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set tituloCompleto = (titulo + " | " + iglesia.sigla + " Logroño") if titulo else ("Iglesia evangélica bautista en Logroño | " + iglesia.sigla) %}
  <title>{{ tituloCompleto }}</title>
  <meta name="description" content="{{ descripcion or 'Iglesia Bautista Internacional de Logroño. Te esperamos el domingo a las 11:30 en Ronda de los Cuarteles, 32.' }}">
  <link rel="canonical" href="https://www.iglesiabautistalogrono.com{{ page.url }}">
  <meta property="og:title" content="{{ tituloCompleto }}">
  <meta property="og:description" content="{{ descripcion or 'Iglesia Bautista Internacional de Logroño. Te esperamos el domingo a las 11:30.' }}">
  <meta property="og:image" content="https://www.iglesiabautistalogrono.com/img/og.jpg">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_ES">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/icono-192.png">
  <link rel="preload" href="/fuentes/cormorant-garamond-500.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fuentes/public-sans-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/componentes.css">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>

  <header class="cabecera">
    <div class="contenedor">
      <a class="cabecera__logo" href="/" aria-label="{{ iglesia.nombre }}, inicio">
        <img src="/img/marca/logo-horizontal.svg" alt="" width="260" height="73">
      </a>
      {%- set menu = [
        { url: "/eres-nuevo/", texto: "¿Eres nuevo?" },
        { url: "/conoce-a-jesus/", texto: "Conoce a Jesús" },
        { url: "/predicaciones/", texto: "Predicaciones" },
        { url: "/noticias/", texto: "Noticias" },
        { url: "/nosotros/", texto: "Nosotros" },
        { url: "/nosotros/que-creemos/", texto: "Qué creemos" },
        { url: "/vida-de-iglesia/", texto: "Vida de iglesia" },
        { url: "/contacto/", texto: "Contacto" }
      ] %}
      <nav class="menu" aria-label="Principal">
        {%- for m in menu %}
        <a href="{{ m.url }}"{% if page.url == m.url or (m.url != '/' and page.url.startsWith(m.url) and not (m.url == '/nosotros/' and page.url.startsWith('/nosotros/que-creemos/'))) %} aria-current="page"{% endif %}>{{ m.texto }}</a>
        {%- endfor %}
        <a class="boton boton--primario" href="/eres-nuevo/">Visítanos este domingo</a>
      </nav>
      <button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu-movil">Menú</button>
    </div>
    <nav id="menu-movil" class="menu-movil" aria-label="Principal (móvil)" hidden>
      <ul role="list">
        {%- for m in menu %}
        <li><a href="{{ m.url }}"{% if page.url == m.url or (page.url.startsWith(m.url) and not (m.url == '/nosotros/' and page.url.startsWith('/nosotros/que-creemos/'))) %} aria-current="page"{% endif %}>{{ m.texto }}</a></li>
        {%- endfor %}
        <li><a href="/predicaciones/en-un-minuto/" class="menu-movil__sub">En un minuto (reels)</a></li>
        <li><a href="/reflexion-diaria/" class="menu-movil__sub">Reflexión diaria</a></li>
        <li><a href="/agenda/" class="menu-movil__sub">Agenda</a></li>
      </ul>
      <a class="boton boton--primario" href="/eres-nuevo/">Visítanos este domingo</a>
    </nav>
  </header>

  <main id="contenido">
    {{ content | safe }}
  </main>

  <footer class="pie">
    <div class="contenedor">
      <div class="pie__logo"><img src="/img/marca/logo-vertical-blanco.svg" alt="{{ iglesia.nombre }}" width="112" height="86"></div>
      <div>
        <h3 class="h4">Dónde y cuándo</h3>
        <address>{{ iglesia.direccion.calle }}<br>{{ iglesia.direccion.cp }} {{ iglesia.direccion.ciudad }}</address>
        <p>Domingos a las {{ iglesia.horarios.domingo[2].hora }}, culto de adoración.</p>
        <p><a href="{{ iglesia.direccion.mapsUrl }}" rel="noopener">Cómo llegar</a></p>
      </div>
      <div>
        <h3 class="h4">Escríbenos</h3>
        <ul role="list">
          <li><a href="{{ iglesia.contacto.whatsappUrl }}" rel="noopener">WhatsApp {{ iglesia.contacto.whatsapp }}</a></li>
          <li><a href="mailto:{{ iglesia.contacto.correo }}">{{ iglesia.contacto.correo }}</a></li>
          <li><a href="/contacto/">Formulario de contacto</a></li>
          <li><a href="/agenda/">Agenda</a></li>
        </ul>
      </div>
      <div>
        <h3 class="h4">Síguenos</h3>
        {{ m.redes(iglesia) }}
      </div>
      <div class="pie__legal">
        <span>© {{ anio }} {{ iglesia.nombre }}</span>
        <span>Iglesia de la <a href="https://uebe.org/" rel="noopener">UEBE</a></span>
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/cookies/">Cookies</a>
        <a href="/accesibilidad/">Accesibilidad</a>
        <span class="pie__rv60">Texto bíblico: Reina-Valera 1960 © Sociedades Bíblicas en América Latina, 1960. Renovado © Sociedades Bíblicas Unidas, 1988. Utilizado con permiso.</span>
      </div>
    </div>
  </footer>

  <nav class="barra-movil" aria-label="Acceso rápido">
    <a href="{{ iglesia.direccion.mapsUrl }}" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/></svg>Cómo llegar</a>
    <a href="{{ iglesia.contacto.whatsappUrl }}" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19.2L4 20z"/></svg>WhatsApp</a>
  </nav>

  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Church","name":"{{ iglesia.nombre }}","alternateName":"{{ iglesia.sigla }}","url":"https://www.iglesiabautistalogrono.com/","logo":"https://www.iglesiabautistalogrono.com/icono-192.png","image":"https://www.iglesiabautistalogrono.com/img/og.jpg","email":"{{ iglesia.contacto.correo }}","telephone":"+34{{ iglesia.contacto.whatsapp | replace(" ", "") }}","address":{"@type":"PostalAddress","streetAddress":"Ronda de los Cuarteles, 32, bajo","postalCode":"{{ iglesia.direccion.cp }}","addressLocality":"{{ iglesia.direccion.ciudad }}","addressRegion":"{{ iglesia.direccion.provincia }}","addressCountry":"ES"},"geo":{"@type":"GeoCoordinates","latitude":{{ iglesia.direccion.lat }},"longitude":{{ iglesia.direccion.lng }}},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":"Sunday","opens":"10:00","closes":"13:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Wednesday","opens":"19:00","closes":"20:30"}],"sameAs":["{{ iglesia.redes.youtube }}","{{ iglesia.redes.instagram }}","{{ iglesia.redes.facebook }}"],"memberOf":{"@type":"Organization","name":"Unión Evangélica Bautista de España","url":"https://uebe.org/"}}
  </script>
  <script src="/js/web.js" defer></script>
</body>
</html>
