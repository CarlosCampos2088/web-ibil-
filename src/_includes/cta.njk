{% import "macros.njk" as m %}
<section class="seccion seccion--arena cta">
  <div class="contenedor dos">
    <div class="texto">
      <h2>Te esperamos este domingo</h2>
      <p class="grande" style="margin-top: var(--s-4)">A las {{ iglesia.horarios.domingo[2].hora }}, en {{ iglesia.direccion.calle }}, {{ iglesia.direccion.ciudad }}. Si nos escribes antes, alguien te esperará en la puerta.</p>
      <div class="botones" style="margin-top: var(--s-5)">
        <a class="boton boton--secundario boton--icono" href="{{ iglesia.contacto.whatsappVisita }}" rel="noopener">{{ m.iconoWhatsapp() }}<span>Avísanos que vienes</span></a>
        <a class="boton boton--secundario" href="/eres-nuevo/">Qué esperar el domingo</a>
      </div>
    </div>
    {%- set rotacion = ["conversando","oracion-mayores","familia-lee","lector-biblia","hermana-lee","joven-ora","predicador-joven-2","oracion-de-pie"] -%}
    {%- set f = ctaFoto or rotacion[(page.url | length) % 8] -%}
    <figure class="figura">{% foto f, { sizes: "(min-width: 48rem) 50vw, 100vw" } %}</figure>
  </div>
</section>
