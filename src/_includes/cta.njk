<section class="seccion seccion--arena cta">
  <div class="contenedor dos">
    <div class="texto">
      <h2>Te esperamos este domingo</h2>
      <p class="grande" style="margin-top: var(--s-4)">A las {{ iglesia.horarios.domingo[2].hora }}, en {{ iglesia.direccion.calle }}, {{ iglesia.direccion.ciudad }}. Si nos escribes antes, alguien te esperará en la puerta.</p>
      <div class="botones" style="margin-top: var(--s-5)">
        <a class="boton boton--primario" href="/eres-nuevo/">Qué esperar el domingo</a>
        <a class="boton boton--secundario" href="{{ iglesia.contacto.whatsappUrl }}" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>
    <figure class="figura">{% foto "saludo", { sizes: "(min-width: 48rem) 50vw, 100vw" } %}</figure>
  </div>
</section>
